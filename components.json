{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/index.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@magicui": "https://magicui.design/r/{name}.json",
    "@aceternity": "https://ui.aceternity.com/registry/{name}.json",
    "@react-bits": "https://reactbits.dev/r/{name}.json",
    "@motion-primitives": "https://motion-primitives.com/c/{name}.json",
    "@animate-ui": "https://animate-ui.com/r/{name}.json",
    "@tailark": "https://tailark.com/r/{name}.json",
    "@cult-ui": "https://www.cult-ui.com/r/{name}.json",
    "@kokonutui": "https://kokonutui.com/r/{name}.json",
    "@eldoraui": "https://eldoraui.site/r/{name}.json",
    "@skiper-ui": "https://skiper-ui.com/registry/{name}.json",
    "@launchui": "https://www.launchuicomponents.com/r/{name}.json",
    "@originui": "https://raw.githubusercontent.com/origin-space/originui/main/apps/ui/public/r/{name}.json"
  }
}
